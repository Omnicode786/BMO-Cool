# Secrets: copy to .env and chmod 600 .env. Never commit .env.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Verified current defaults as of 2026-09-06.
GEMINI_BRAIN_MODEL=gemini-3.7-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=pcm_24000

SAVE_DEBUG_MEDIA=false
LOG_LEVEL=INFO
BMO_PERFORMANCE_MODE=normal
# Explicit development-only cloud mocks. Leave false in production.
BMO_MOCK_CLOUD=false
